{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm ci *)",
      "Bash(npm run build)",
      "Bash(npm run test-e2e *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(node scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push origin HEAD:main)",
      "Bash(npm publish *)"
    ]
  }
}
