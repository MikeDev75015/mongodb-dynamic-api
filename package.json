{
  "name": "mongodb-dynamic-api",
  "version": "5.1.0",
  "description": "Auto generated CRUD API for MongoDB using NestJS",
  "readmeFilename": "README.md",
  "main": "index.js",
  "types": "index.d.ts",
  "schematics": "./schematics/collection.json",
  "bin": {
    "mongodb-dynamic-api": "./codemods/migrate-v5/cli.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && tsc -p tsconfig.schematics.json && node scripts/copy-schematics-assets.cjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "vitest run",
    "test-cov": "vitest run --coverage",
    "test-e2e": "vitest run --config vitest.e2e.config.ts",
    "test-e2e:ci": "vitest run --config vitest.e2e.config.ts --reporter=default --reporter=junit --outputFile=reports/junit/results.xml",
    "test:ci:junit": "vitest run --coverage --reporter=default --reporter=junit --outputFile=reports/junit/results.xml",
    "test:ci:sonar": "vitest run --coverage --reporter=default --reporter=vitest-sonar-reporter --outputFile=reports/sonar/test-report.xml",
    "pre-release-tag": "git tag -f prerelease && git push -f origin prerelease",
    "release-tag": "git tag -f release && git push -f origin release",
    "auto-prerelease": "release-it --ci --preRelease=beta",
    "auto-release": "release-it --ci",
    "publish-prerelease": "npm publish ./dist --tag prerelease",
    "publish-release": "npm publish ./dist --tag latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeDev75015/mongodb-dynamic-api.git"
  },
  "keywords": [
    "nestjs",
    "mongodb",
    "dynamic-api",
    "crud"
  ],
  "author": "Mickaël NODANCHE <mikeonline75@gmail.com> (https://cv-mikeonline.web.app)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MikeDev75015/mongodb-dynamic-api/issues"
  },
  "homepage": "https://mikedev75015.github.io",
  "dependencies": {
    "@angular-devkit/schematics": "^19.2.27",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@types/lodash": "^4.14.202",
    "bcrypt": "^5.1.1",
    "cache-manager": "^6.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb-pipeline-builder": "^4.0.2",
    "mongoose": "^8.9.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.7.5",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^11.0.0",
    "@swc/cli": "^0.3.9",
    "@swc/core": "^1.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lcov-result-merger": "^5.0.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.2.5",
    "release-it": "^20.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "overrides": {
    "@nestjs/throttler": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/core": "$@nestjs/core"
    },
    "@nestjs/schematics": {
      "typescript": "$typescript"
    },
    "@nestjs/cli": {
      "@swc/cli": "$@swc/cli",
      "@swc/core": "$@swc/core",
      "ts-loader": "$ts-loader"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
